# Copy to watcher.env and fill in — deploy_watcher.sh sources this automatically.
# watcher.env is gitignored (contains your project/engine ids). Do NOT commit it.

# ── Required ──────────────────────────────────────────────────────────────────
PROJECT_ID=your-project-id
REGION=us-central1
# Full resource path from your agent deploy output:
AGENT_ENGINE_ID=projects/PROJECT_NUMBER/locations/us-central1/reasoningEngines/ENGINE_ID
WATCH_USER=you@yourco.com          # shopper email(s), comma-separated

# ── Optional (have sensible defaults) ────────────────────────────────────────
# Must match the agent's memory app name (agent default = shopping_companion):
MEMORY_APP_NAME=shopping_companion
DROP_PCT=20
JOB_NAME=price-watcher
SCHEDULE=0 * * * *                 # hourly
# Service accounts (job needs roles/aiplatform.user; scheduler needs roles/run.invoker):
# JOB_SA=price-watcher@your-project-id.iam.gserviceaccount.com
# SCHED_SA=price-watcher@your-project-id.iam.gserviceaccount.com
